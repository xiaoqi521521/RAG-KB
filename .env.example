# App
APP_NAME=rag-kb
APP_ENV=local
APP_DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=postgresql+asyncpg://ragkb:ragkb123@localhost:5432/ragkb
SYNC_DATABASE_URL=postgresql+psycopg://ragkb:ragkb123@localhost:5432/ragkb
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
EMBEDDING_CACHE_TTL_SECONDS=604800
QUERY_CACHE_TTL_SECONDS=600
QUERY_CACHE_TIMEOUT_SECONDS=1
QUERY_CACHE_MAX_RETRIES=1
TOKEN_STATS_TIMEOUT_SECONDS=1
TOKEN_STATS_MAX_RETRIES=1
TOKEN_BUDGET_DAILY_CNY=1.00
TOKEN_BUDGET_TIMEZONE=Asia/Shanghai
TOKEN_REQUEST_ALERT_COST_CNY=0.01
# 阿里云百炼官方控制台（中国内地/北京）标准价，单位：CNY/1K tokens
# text-embedding-v3 文本输入：0.5 CNY/百万 tokens
# deepseek-v4-flash 输入：1 CNY/百万 tokens；输出：2 CNY/百万 tokens
# 成本服务当前没有缓存命中 token 维度，因此按未命中输入价估算。
EMBEDDING_INPUT_COST_CNY_PER_1K_TOKENS=0.0005
CHAT_INPUT_COST_CNY_PER_1K_TOKENS=0.001
CHAT_OUTPUT_COST_CNY_PER_1K_TOKENS=0.002
RERANKER_COST_CNY_PER_1K_TOKENS=0.0005

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-documents
MINIO_SECURE=false

# DashScope OpenAI-compatible API
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=deepseek-v4-flash
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_CACHE_VERSION=v1
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=3
CHAT_TEMPERATURE=0.1
CHAT_MAX_TOKENS=2048
RAGAS_MAX_TOKENS=4096
RAGAS_TIMEOUT_SECONDS=60
CHAT_STREAM_TIMEOUT_SECONDS=60

# Reranker
RERANKER_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANKER_MODEL=gte-rerank-v2
RERANKER_TIMEOUT_MS=800
RERANKER_TOP_N=5

# RAG
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_VECTOR_TOP_K=20
RAG_FULLTEXT_TOP_K=20
RAG_RETURN_TOP_N=5
RAG_QUERY_PIPELINE=v4
RAG_MIN_SCORE=0.5
RAG_CONTEXT_MAX_TOKENS=3000
RAG_FAITHFULNESS_SAMPLE_RATE=0.2
RAG_FAITHFULNESS_TIMEOUT_SECONDS=5

# Upload
MAX_UPLOAD_FILE_SIZE_MB=50
MAX_UPLOAD_REQUEST_SIZE_MB=100

# Document Loading / MinerU
MINERU_ENABLED=true
MINERU_MODE=sdk
MINERU_API_TYPE=precision
MINERU_API_URL=
MINERU_API_KEY=
MINERU_TIMEOUT_SECONDS=300

# Observability
LOG_LEVEL=INFO
ENABLE_METRICS=false
