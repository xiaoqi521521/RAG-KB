# Compose 基础设施账号
POSTGRES_USER=ragkb
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=ragkb
MINIO_ACCESS_KEY=replace-with-minio-user
MINIO_SECRET_KEY=replace-with-a-strong-minio-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password

# 应用配置
APP_ENV=production
APP_DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret
ENABLE_METRICS=true
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_LIMIT_CONCURRENCY=100
SERVER_TIMEOUT_KEEP_ALIVE_SECONDS=10
SERVER_TIMEOUT_GRACEFUL_SHUTDOWN_SECONDS=30

# 发布镜像名；CI/发布机应替换为带版本号或 Git SHA 的不可变标签
BACKEND_IMAGE=rag-kb-backend:local
FRONTEND_IMAGE=rag-kb-frontend:local

# 模型和 Reranker 凭据
DASHSCOPE_API_KEY=replace-with-dashscope-key
OPENAI_API_KEY=replace-with-dashscope-key
EMBEDDING_API_KEY=replace-with-dashscope-key
RERANKER_API_KEY=replace-with-reranker-key
RERANKER_ENDPOINT=https://example.invalid/rerank
MINERU_API_KEY=replace-with-mineru-key

# Compose 会覆盖以下服务地址；保留它们便于单独运行后端时复用模板
DATABASE_URL=postgresql+asyncpg://ragkb:replace-with-a-strong-password@db:5432/ragkb
SYNC_DATABASE_URL=postgresql+psycopg://ragkb:replace-with-a-strong-password@db:5432/ragkb
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_BUCKET=rag-documents
