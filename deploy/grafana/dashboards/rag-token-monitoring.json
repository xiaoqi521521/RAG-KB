{
  "uid": "rag-token-monitoring",
  "title": "RAG-KB Token 监控",
  "schemaVersion": 39,
  "version": 5,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "model",
        "label": "模型",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "rag-prometheus"
        },
        "query": "label_values({__name__=~\"rag_token_usage_total|rag_evaluation_token_usage_total\"}, model)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": false,
          "text": ["All"],
          "value": ["$__all"]
        }
      },
      {
        "name": "token_type",
        "label": "Token 类型",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "rag-prometheus"
        },
        "query": "label_values({__name__=~\"rag_token_usage_total|rag_evaluation_token_usage_total\"}, token_type)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "regex": "/^(answer_generation|embedding|faithfulness_check|hyde|input|intent|ragas_embedding|ragas_evaluation|ragas_input|reranker)$/",
        "current": {
          "selected": false,
          "text": ["All"],
          "value": ["$__all"]
        }
      },
      {
        "name": "component",
        "label": "失败组件",
        "type": "custom",
        "query": "embedding,input,answer_generation,intent,hyde,reranker,faithfulness_check,ragas_input,ragas_evaluation,ragas_embedding,budget",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": false,
          "text": ["All"],
          "value": ["$__all"]
        }
      },
      {
        "name": "kb_id",
        "label": "知识库范围",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "rag-prometheus"
        },
        "query": "label_values({__name__=~\"rag_token_usage_total|rag_evaluation_token_usage_total\"}, kb_id)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": false,
          "text": ["All"],
          "value": ["$__all"]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "今日预算已用（CNY）",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rag_daily_usage_cost_cny{scope=\"global\"}",
          "legendFormat": "预算"
        }
      ],
      "description": "当日预算/估算成本由后端全局用量服务聚合 Redis 非评估消耗与评估 run 数据库汇总。",
      "time": {
        "from": "now/d",
        "to": "now"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 5,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 1.0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "今日 Token 用量",
      "gridPos": {
        "x": 3,
        "y": 0,
        "w": 3,
        "h": 8
      },
      "targets": [
        {
          "refId": "B",
          "expr": "rag_daily_usage_tokens{scope=\"global\"}",
          "legendFormat": "Token",
          "instant": true
        }
      ],
      "description": "当日 Token 总量由后端全局用量服务聚合 Redis 非评估消耗与评估 run 数据库汇总。",
      "time": {
        "from": "now/d",
        "to": "now"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#5794F2"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "检索问答 Token 累计用量",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 9,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (token_type) (rag_token_usage_total{model=~\"$model\",token_type=~\"$token_type\",token_type!=\"evaluation\",kb_id=~\"$kb_id\"})",
          "legendFormat": "{{token_type}}"
        }
      ],
      "description": "仅检索问答管道七类消耗；评估运行写入 rag_evaluation_token_usage_total。历史旧样本不回溯改写，计数器重启后清零。"
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "检索问答累计估算成本（CNY）",
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 9,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (token_type, model, kb_id) (rag_token_usage_cost_cny_total{model=~\"$model\",token_type=~\"$token_type\",token_type!=\"evaluation\",kb_id=~\"$kb_id\"})",
          "legendFormat": "{{token_type}} / {{model}} / kb={{kb_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyCNY"
        }
      },
      "description": "仅检索问答管道七类消耗；评估运行成本由 rag_evaluation_token_usage_cost_cny_total 单独承载。历史旧样本不回溯改写，计数器重启后清零。"
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "监控异常计数",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (token_type, model, kb_id) (increase(rag_token_usage_unavailable_total{model=~\"$model\",token_type=~\"$token_type\",kb_id=~\"$kb_id\"}[1h]))",
          "legendFormat": "usage unavailable ({{token_type}})"
        },
        {
          "expr": "increase(rag_token_request_cost_over_limit_total[1h])",
          "legendFormat": "request cost over limit"
        },
        {
          "expr": "sum by (sink, component) (increase(rag_token_write_failure_total{component=~\"$component\"}[1h]))",
          "legendFormat": "sink write failure ({{sink}} / {{component}})"
        }
      ]
      ,
      "description": "usage unavailable 按模型、Token 类型和知识库范围过滤；写入失败按失败组件过滤，All 时包含 budget。单次请求成本超限是全局观测，不受过滤器影响。"
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "评估运行 Token 累计用量",
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (token_type) (rag_evaluation_token_usage_total{model=~\"$model\",token_type=~\"$token_type\",kb_id=~\"$kb_id\"})",
          "legendFormat": "{{token_type}}"
        }
      ],
      "description": "完整评估运行的模型消耗。input/embedding 表示评估 RAG 执行，ragas_input/ragas_evaluation/ragas_embedding 表示 RAGAS 判定；计数器自部署起累加，进程重启后清零。"
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "评估运行累计估算成本（CNY）",
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (token_type, model, kb_id) (rag_evaluation_token_usage_cost_cny_total{model=~\"$model\",token_type=~\"$token_type\",kb_id=~\"$kb_id\"})",
          "legendFormat": "{{token_type}} / {{model}} / kb={{kb_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyCNY"
        }
      },
      "description": "完整评估运行分阶段成本（RAG 执行 + RAGAS 判定）；计数器自后端进程启动起累加，进程重启后清零。"
    },
    {
      "id": 7,
      "type": "state-timeline",
      "title": "告警状态",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "expr": "ALERTS{alertstate=\"firing\",alertname=~\"RagTokenBudgetWarning|RagTokenBudgetExhausted\"}",
          "legendFormat": "{{alertname}} / {{severity}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "RagTokenBudgetExhausted / critical"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F2495C"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RagTokenBudgetWarning / warning"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FADE2A"
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
