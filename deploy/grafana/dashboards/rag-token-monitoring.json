{
  "uid": "rag-token-monitoring",
  "title": "RAG-KB Token 监控",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "model",
        "label": "模型",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "rag-prometheus"
        },
        "query": "label_values(rag_token_usage_total, model)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true
      },
      {
        "name": "token_type",
        "label": "Token 类型",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "rag-prometheus"
        },
        "query": "label_values(rag_token_usage_total, token_type)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true
      },
      {
        "name": "kb_id",
        "label": "知识库范围",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "rag-prometheus"
        },
        "query": "label_values(rag_token_usage_total, kb_id)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "今日预算已用（CNY）",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "expr": "rag_token_budget_used_cny{scope=\"global\"}",
          "legendFormat": "used"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyCNY",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 1.0
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "5 分钟 Token 速率",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 9,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (token_type) (rate(rag_token_usage_total{model=~\"$model\",token_type=~\"$token_type\",kb_id=~\"$kb_id\"}[5m]))",
          "legendFormat": "{{token_type}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "估算成本速率（CNY）",
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 9,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (token_type,model,kb_id) (rate(rag_token_usage_cost_cny_total{model=~\"$model\",token_type=~\"$token_type\",kb_id=~\"$kb_id\"}[5m]))",
          "legendFormat": "{{token_type}} / {{model}} / kb={{kb_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyCNY"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "近 24 小时 Token 增量",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (token_type) (increase(rag_token_usage_total{model=~\"$model\",token_type=~\"$token_type\",kb_id=~\"$kb_id\"}[24h]))",
          "legendFormat": "{{token_type}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "监控异常计数",
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "increase(rag_token_usage_unavailable_total[1h])",
          "legendFormat": "usage unavailable"
        },
        {
          "expr": "increase(rag_token_request_cost_over_limit_total[1h])",
          "legendFormat": "request cost over limit"
        },
        {
          "expr": "increase(rag_token_write_failure_total[1h])",
          "legendFormat": "sink write failure"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "评估判定成本速率（CNY）",
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (model,kb_id) (rate(rag_token_usage_cost_cny_total{token_type=\"evaluation\",model=~\"$model\",kb_id=~\"$kb_id\"}[5m]))",
          "legendFormat": "{{model}} / kb={{kb_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyCNY"
        }
      }
    },
    {
      "id": 7,
      "type": "state-timeline",
      "title": "告警状态",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "expr": "ALERTS{alertstate=\"firing\",alertname=~\"RagTokenBudgetWarning|RagTokenBudgetExhausted|RagSingleRequestCostLimit|RagTokenSinkWriteFailure\"}",
          "legendFormat": "{{alertname}} / {{severity}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "RagSingleRequestCostLimit / critical"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F2495C"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RagTokenBudgetExhausted / critical"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F2495C"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RagTokenBudgetWarning / warning"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FADE2A"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RagTokenSinkWriteFailure / warning"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FADE2A"
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
